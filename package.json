{
  "name": "lazybb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.tsx",
    "install:local": "./scripts/install-local.sh",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@opentui/core": "latest",
    "@opentui/react": "latest",
    "react": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "^19.2.16",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "tsx": "latest",
    "typescript": "latest"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc}": [
      "oxfmt",
      "oxlint"
    ],
    "*.{md,yml,yaml}": "oxfmt"
  },
  "packageManager": "pnpm@10.0.0"
}
